{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 13 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Pulls the last two weeks of sleep and activity from every connected wearable each morning",
  "name": "Nightly Health Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_health_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_wearables": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "healthSync",
            "args": {
              "all": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync sleep & activity",
            "description": "Every connected wearable"
          }
        }
      }
    ]
  }
}