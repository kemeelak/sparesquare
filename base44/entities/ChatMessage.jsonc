{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "Who sent the message"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "context": {
      "type": "string",
      "enum": [
        "onboarding",
        "partner",
        "plugin"
      ],
      "description": "Which chat context this belongs to"
    },
    "thread_id": {
      "type": "string",
      "description": "ID of the ChatThread this message belongs to"
    },
    "metadata": {
      "type": "object",
      "description": "Any structured data from the AI response",
      "additionalProperties": true
    }
  },
  "required": [
    "role",
    "content"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}