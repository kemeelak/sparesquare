{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "rhythm_type": {
      "type": "string",
      "enum": [
        "nine_to_five",
        "student",
        "night_shift",
        "freelancer",
        "parent",
        "other"
      ],
      "description": "User's work rhythm type"
    },
    "sleep_actual": {
      "type": "string",
      "description": "Actual sleep time e.g. 12:00 AM"
    },
    "sleep_goal": {
      "type": "string",
      "description": "Goal sleep time e.g. 10:30 PM"
    },
    "wake_time": {
      "type": "string",
      "description": "Wake up time e.g. 6:00 AM"
    },
    "growth_focus": {
      "type": "string",
      "enum": [
        "fitness",
        "business",
        "peace",
        "learning",
        "creativity",
        "relationships"
      ],
      "description": "Primary area the user is working on"
    },
    "growth_focuses": {
      "type": "array",
      "description": "Every area the user is working on \u2014 they can be growing in more than one at once",
      "items": {
        "type": "string",
        "enum": [
          "fitness",
          "business",
          "peace",
          "learning",
          "creativity",
          "relationships"
        ]
      }
    },
    "energy_pattern": {
      "type": "string",
      "description": "When in the day the user feels most energized and focused, in their own words"
    },
    "extra_notes": {
      "type": "array",
      "description": "Anything else the user volunteered about their life \u2014 kept so coaching can use it instead of asking again",
      "items": {
        "type": "string"
      }
    },
    "unmovables": {
      "type": "array",
      "description": "List of unmovable blocks",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "start_hour": {
            "type": "number"
          },
          "end_hour": {
            "type": "number"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "goals_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "timezone_offset": {
      "type": "number",
      "description": "User timezone offset in hours"
    },
    "partner_name": {
      "type": "string",
      "description": "User's chosen name for their AI partner"
    },
    "calendar_feed_url": {
      "type": "string",
      "description": "Read-only calendar feed (iCloud / Apple Calendar public share link) mapped onto the grid"
    },
    "goals": {
      "type": "array",
      "description": "User's specific life goals",
      "items": {
        "type": "string"
      }
    },
    "challenges": {
      "type": "array",
      "description": "Past challenges / blockers the user has faced",
      "items": {
        "type": "string"
      }
    },
    "motivation": {
      "type": "string",
      "description": "Why the user is doing this \u2014 their deeper why"
    },
    "existing_habits": {
      "type": "array",
      "description": "Routines and habits the user already keeps consistently \u2014 never suggest these back to them",
      "items": {
        "type": "string"
      }
    },
    "commute": {
      "type": "object",
      "description": "Opt-in commute setup: when and how the user travels, and what they like to consume on the way",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "drive",
            "transit",
            "passenger",
            "walk_bike"
          ],
          "description": "How they travel \u2014 decides whether reading and watching are possible"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Days of the week they commute"
        },
        "start_hour": {
          "type": "number",
          "description": "Hour the commute starts \u2014 decimal hours, 30-minute steps (8.5 = 8:30 AM)"
        },
        "end_hour": {
          "type": "number",
          "description": "Hour the commute ends \u2014 decimal hours, 30-minute steps (9.5 = 9:30 AM)"
        },
        "return_start_hour": {
          "type": "number",
          "description": "Hour the ride home starts \u2014 decimal hours, 30-minute steps (17.5 = 5:30 PM)"
        },
        "return_end_hour": {
          "type": "number",
          "description": "Hour the ride home ends \u2014 decimal hours, 30-minute steps (18.5 = 6:30 PM)"
        },
        "apps": {
          "type": "object",
          "description": "The apps the user consumes content in, so suggestions open in the right place",
          "properties": {
            "audio": {
              "type": "string",
              "enum": [
                "spotify",
                "apple_podcasts",
                "youtube_music",
                "youtube",
                "in_app"
              ]
            },
            "reading": {
              "type": "string",
              "enum": [
                "kindle",
                "audible",
                "youtube",
                "none"
              ]
            }
          }
        },
        "formats": {
          "type": "array",
          "description": "Content formats they actually enjoy on a ride \u2014 podcasts, music, video, books, thinking drills, mind games, talking it out, courses",
          "items": {
            "type": "string"
          }
        },
        "consumes": {
          "type": "string",
          "enum": [
            "in_app",
            "podcasts",
            "youtube",
            "read",
            "nothing"
          ],
          "description": "Legacy: where they consumed content before app preferences existed"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Content topics they actually enjoy"
        }
      }
    }
  },
  "required": [],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}