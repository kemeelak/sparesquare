{
  "name": "ChatThread",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Thread title"
    },
    "category": {
      "type": "string",
      "enum": [
        "fitness",
        "mindfulness",
        "learning",
        "nutrition",
        "sleep",
        "productivity",
        "social",
        "creative",
        "general"
      ],
      "default": "general"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "last_message_preview": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}