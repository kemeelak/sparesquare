{
  "name": "HealthLinkTicket",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short-lived authorization code from the wearable provider \u2014 server only"
    },
    "provider": {
      "type": "string",
      "enum": [
        "oura",
        "fitbit"
      ]
    },
    "state_user_id": {
      "type": "string",
      "description": "The member who started the consent flow; only that account may claim it"
    }
  },
  "required": [
    "code",
    "provider",
    "state_user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}