{
  "name": "DumpEntry",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The few words on the front of the card \u2014 what this dump is about"
    },
    "text": {
      "type": "string",
      "description": "Whatever they got out of their head \u2014 a rant, a worry, something they're stuck on"
    },
    "photo_url": {
      "type": "string",
      "description": "Private storage path of the photo they dropped in, if any"
    },
    "reflection": {
      "type": "string",
      "description": "The one thing that came back to them"
    },
    "action_title": {
      "type": "string",
      "description": "The single small move offered back"
    },
    "action_description": {
      "type": "string"
    },
    "action_minutes": {
      "type": "number"
    },
    "action_category": {
      "type": "string",
      "enum": [
        "fitness",
        "mindfulness",
        "learning",
        "nutrition",
        "sleep",
        "productivity",
        "social",
        "creative",
        "general"
      ]
    },
    "action_life_area": {
      "type": "string",
      "enum": [
        "work",
        "people",
        "faith",
        "fun",
        "health"
      ]
    },
    "action_status": {
      "type": "string",
      "enum": [
        "suggested",
        "kept",
        "dropped"
      ],
      "default": "suggested"
    },
    "action_draft": {
      "type": "object",
      "description": "The email or message the partner wrote for them to send, once they asked for it",
      "properties": {
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "description": "When it was written, ISO"
        }
      }
    },
    "follow_ups": {
      "type": "array",
      "description": "Notes the member added onto the same dump later, in the order they added them",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "description": "When it was added, ISO"
          },
          "photo_url": {
            "type": "string",
            "description": "Private storage path of a photo added with this note"
          },
          "voice_uri": {
            "type": "string",
            "description": "Private storage path of a voice recording added with this note"
          },
          "notes": {
            "type": "array",
            "description": "Notes the member added onto this addition when they opened it, in order",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "description": "When it was added, ISO"
                },
                "photo_url": {
                  "type": "string",
                  "description": "Private storage path of a photo added with this note"
                },
                "voice_uri": {
                  "type": "string",
                  "description": "Private storage path of a voice recording added with this note"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}